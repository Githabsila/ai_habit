BOT_TOKEN=your_telegram_bot_token_here

OPENAI_API_KEY=your_openai_api_key_here

ADMIN_ID=your_telegram_user_id_here

# Опционально: быстрый AI-канал для чата Mini App
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ADAM AI cost protection
AI_MAX_INPUT_CHARS=6000
AI_TELEGRAM_MAX_INPUT_CHARS=4000
AI_LONG_COST_CHARS=2200
AI_VERY_LONG_COST_CHARS=4000
AI_DAILY_FREE_COST_UNITS=15
AI_DAILY_PRO_COST_UNITS=15

# Возвраты и вопросы по оплате: Instagram (ник или ссылка), рядом с Telegram-контактами SUPPORT_CONTACT
SUPPORT_INSTAGRAM=
# Шифрование резервных копий (python tools/make_backup_key.py); без ключа копии уходят незашифрованными
BACKUP_ENCRYPTION_KEY=
# Автоудаление неактивных аккаунтов через N месяцев без заходов (0 — выключено)
INACTIVE_PURGE_MONTHS=0

# Mini App и веб-сервер (Railway задаёт PORT сам)
WEBAPP_URL=https://your-app.up.railway.app
PORT=8080
# База на постоянном томе Railway (без тома база стирается при каждой выкладке)
RAILWAY_VOLUME_MOUNT_PATH=

# Подписка
SUBSCRIPTION_TRIAL_DAYS=3
SUBSCRIPTION_INTRO_PRICE_STARS=153
SUBSCRIPTION_RENEWAL_PRICE_STARS=461
SUBSCRIPTION_GATE_ENABLED=false
SUBSCRIPTION_GATE_CUTOVER=2100-01-01
SUBSCRIPTION_AUTORENEW_ENABLED=false
SUBSCRIPTION_STREAK_DAYS_FOR_CHANNEL=3
# Закрытый канал подписчиков (id вида -100…)
CLOSED_CHANNEL_ID=
CHANNEL_REENTRY_STREAK_DAYS=5
AUTO_APPROVE_HOURS=3
PREMIUM_TIER_ENABLED=false
PREMIUM_PRICE_STARS=150

# Оплата картой / криптой (выключатель — EXTERNAL_PAYMENTS_ENABLED)
EXTERNAL_PAYMENTS_ENABLED=false
TRIBUTE_API_KEY=
LAVA_API_KEY=
LAVA_WEBHOOK_SECRET=
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=

# Поддержка
SUPPORT_EMAIL=
SUPPORT_CONTACT=

# Защита расходов на ИИ и алерты
AI_GLOBAL_DAILY_UNIT_CEILING=5000
AI_DAILY_TOKEN_CEILING=2000000
AI_USER_DAY_TOKENS=0
ERROR_SPIKE_THRESHOLD=10
